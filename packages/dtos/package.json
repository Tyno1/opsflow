{
	"name": "@repo/dtos",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"exports": {
		".": "./src/index.ts",
		"./openapi.yaml": {
			"types": "./openapi.yaml.d.ts",
			"default": "./src/openapi-yaml.ts"
		}
	},
	"scripts": {
		"generate": "openapi-typescript openapi.yaml -o src/generated/api.ts",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"check-types": "npm run generate && tsc --noEmit"
	},
	"devDependencies": {
		"@repo/typescript-config": "*",
		"@types/node": "^22.15.3",
		"openapi-typescript": "^7.13.0",
		"typescript": "5.9.2"
	},
	"dependencies": {
		"yaml": "^2.8.1"
	}
}
