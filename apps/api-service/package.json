{
	"name": "api-service",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc",
		"start": "node dist/index.js",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"check-types": "tsc --noEmit",
