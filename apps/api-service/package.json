		"migration:create": "prisma migrate dev --create-only",
		"migrate": "prisma migrate deploy"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"@repo/dtos": "*",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.1.0",
		"jose": "^6.2.8",
		"pg": "^8.23.0",
		"pino-http": "^11.0.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@repo/typescript-config": "*",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.3",
		"@types/node": "^22.20.1",
		"@types/pg": "^8.21.0",
		"pino-pretty": "^13.1.3",
		"prisma": "^7.9.1",
		"tsx": "^4.20.5",
		"typescript": "5.9.2"
	}
