// Domain models aligned with packages/dtos/openapi.yaml and docs/erd.md.
// API DTOs are the public contract; this schema may add indexes and
// constraints needed for persistence that are not exposed over HTTP.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  AGENT
  REQUESTER
  VENDOR
}

enum UserStatus {
  ACTIVE
  PENDING_APPROVAL
  DEACTIVATED
}

enum IdentityProvider {
  ENTRA_ID
}

enum PlatformRole {
  PLATFORM_SUPPORT
  PLATFORM_ADMIN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_REQUESTER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketType {
  INCIDENT
  SERVICE_REQUEST
  PROBLEM
  CHANGE
}

enum Sentiment {
  positive
  neutral
  negative
  angry
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum NotificationType {
  TICKET_STATUS_CHANGED
  TICKET_AGENT_REPLIED
  TICKET_ASSIGNED
  STAFF_INVITED
}

enum NotificationChannel {
  EMAIL
}

enum NotificationStatus {
  SENT
  SUPPRESSED
  FAILED
}

enum TicketActivityType {
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNED
  TYPE_CHANGED
  DEPARTMENT_CHANGED
  CATEGORY_CHANGED
}

enum ClassificationSource {
  AI
  MANUAL
}

model Organization {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  subdomain    String   @unique
  supportEmail String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users                  User[]
  domains                OrganizationDomain[]
  invites                Invite[]
  tickets                Ticket[]
  notifications          Notification[]
  departments            Department[]
  platformAccessSessions PlatformAccessSession[]

  @@map("organizations")
}

model OrganizationDomain {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @db.Uuid
  domain            String    @unique
  verified          Boolean   @default(false)
  verificationToken String
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("organization_domains")
}

model User {
  id               String           @id @default(uuid()) @db.Uuid
  identityProvider IdentityProvider
  externalId       String
  organizationId   String           @db.Uuid
  name             String
  email            String
  role             Role?
  status           UserStatus       @default(ACTIVE)
  createdAt        DateTime         @default(now())

  organization                Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticketsCreated              Ticket[]           @relation("TicketCreatedBy")
  ticketsAssigned             Ticket[]           @relation("TicketAssignedTo")
  comments                    Comment[]
  notifications               Notification[]
  invitesCreated              Invite[]           @relation("InviteCreatedBy")
  ticketActivities            TicketActivity[]   @relation("TicketActivityActor")
  ticketAssignmentsAsAssignee TicketAssignment[] @relation("TicketAssignmentAssignee")
  ticketAssignmentsAsAssigner TicketAssignment[] @relation("TicketAssignmentAssignedBy")

  @@unique([identityProvider, externalId])
  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@map("users")
}

model Invite {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  email           String
  role            Role
  status          InviteStatus @default(PENDING)
  invitedByUserId String?      @db.Uuid
  expiresAt       DateTime
  createdAt       DateTime     @default(now())
  acceptedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InviteCreatedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, email])
  @@map("invites")
}

model Department {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categories      Category[]
  tickets         Ticket[]
  classifications TicketClassification[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@map("departments")
}

model Category {
  id           String   @id @default(uuid()) @db.Uuid
  departmentId String   @db.Uuid
  name         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department      Department             @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  subcategories   Subcategory[]
  tickets         Ticket[]
  classifications TicketClassification[]

  @@unique([departmentId, name])
  @@index([departmentId, isActive])
  @@map("categories")
}

model Subcategory {
  id         String   @id @default(uuid()) @db.Uuid
  categoryId String   @db.Uuid
  name       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category        Category               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tickets         Ticket[]
  classifications TicketClassification[]

  @@unique([categoryId, name])
  @@index([categoryId, isActive])
  @@map("subcategories")
}

model Ticket {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  title          String
  description    String
  status         TicketStatus   @default(OPEN)
  priority       TicketPriority @default(MEDIUM)
  type           TicketType     @default(INCIDENT)
  departmentId   String?        @db.Uuid
  categoryId     String?        @db.Uuid
  subcategoryId  String?        @db.Uuid
  sentiment      Sentiment?
  createdById    String         @db.Uuid
  assignedToId   String?        @db.Uuid
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department      Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  category        Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory     Subcategory?           @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  createdBy       User                   @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo      User?                  @relation("TicketAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  comments        Comment[]
  notifications   Notification[]
  activities      TicketActivity[]
  assignments     TicketAssignment[]
  summaries       TicketSummary[]
  classifications TicketClassification[]

  @@index([organizationId, status])
  @@index([organizationId, assignedToId])
  @@index([departmentId])
  @@index([categoryId])
  @@index([subcategoryId])
  @@map("tickets")
}

model Comment {
  id             String   @id @default(uuid()) @db.Uuid
  ticketId       String   @db.Uuid
  authorUserId   String   @db.Uuid
  body           String
  isInternalNote Boolean  @default(false)
  createdAt      DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@map("comments")
}

model TicketActivity {
  id                      String             @id @default(uuid()) @db.Uuid
  ticketId                String             @db.Uuid
  actorUserId             String?            @db.Uuid
  platformAccessSessionId String?            @db.Uuid
  type                    TicketActivityType
  fromValue               String?
  toValue                 String
  metadata                Json?
  createdAt               DateTime           @default(now())

  ticket                Ticket                 @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor                 User?                  @relation("TicketActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  platformAccessSession PlatformAccessSession? @relation(fields: [platformAccessSessionId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt(sort: Desc)])
  @@map("ticket_activities")
}

model TicketAssignment {
  id               String   @id @default(uuid()) @db.Uuid
  ticketId         String   @db.Uuid
  assigneeUserId   String?  @db.Uuid
  assignedByUserId String?  @db.Uuid
  assignedAt       DateTime @default(now())
  note             String?

  ticket     Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assignee   User?  @relation("TicketAssignmentAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  assignedBy User?  @relation("TicketAssignmentAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, assignedAt(sort: Desc)])
  @@map("ticket_assignments")
}

model TicketSummary {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @db.Uuid
  summary   String
  keyPoints String[]
  model     String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt(sort: Desc)])
  @@map("ticket_summaries")
}

model TicketClassification {
  id             String               @id @default(uuid()) @db.Uuid
  ticketId       String               @db.Uuid
  type           TicketType
  departmentId   String?              @db.Uuid
  categoryId     String?              @db.Uuid
  subcategoryId  String?              @db.Uuid
  priority       TicketPriority
  sentiment      Sentiment
  source         ClassificationSource
  shouldEscalate Boolean              @default(false)
  createdAt      DateTime             @default(now())

  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  department  Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt(sort: Desc)])
  @@map("ticket_classifications")
}

model Notification {
  id              String              @id @default(uuid()) @db.Uuid
  userId          String              @db.Uuid
  organizationId  String              @db.Uuid
  type            NotificationType
  channel         NotificationChannel @default(EMAIL)
  relatedTicketId String?             @db.Uuid
  status          NotificationStatus
  sentAt          DateTime?
  createdAt       DateTime            @default(now())

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  relatedTicket Ticket?      @relation(fields: [relatedTicketId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([organizationId])
  @@map("notifications")
}

model PlatformUser {
  id               String           @id @default(uuid()) @db.Uuid
  identityProvider IdentityProvider
  externalId       String
  email            String           @unique
  name             String
  role             PlatformRole
  createdAt        DateTime         @default(now())

  accessSessions PlatformAccessSession[]

  @@unique([identityProvider, externalId])
  @@map("platform_users")
}

model PlatformAccessSession {
  id             String    @id @default(uuid()) @db.Uuid
  platformUserId String    @db.Uuid
  organizationId String    @db.Uuid
  reason         String
  startedAt      DateTime  @default(now())
  endedAt        DateTime?

  platformUser     PlatformUser     @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticketActivities TicketActivity[]

  @@index([organizationId, startedAt(sort: Desc)])
  @@index([platformUserId, endedAt])
  @@map("platform_access_sessions")
}
